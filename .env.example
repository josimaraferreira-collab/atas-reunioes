# Copie para .env.producao no servidor (NÃO versionar). Valores protegidos.
NODE_ENV=production
PORT=3001
APP_URL=https://portal.solven.com.br:4443/solven-atas

# Microsoft Entra ID (registro de aplicativo "Solven Atas")
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Opcional: exige uma função do app (ex.: Atas.Usuario). Vazio = qualquer conta atribuída ao app.
ENTRA_REQUIRED_ROLE=
SESSION_SECRET=
# Duração da sessão em horas (reuniões longas não podem cair no meio). 1 a 24.
SESSION_HOURS=12

# SQL Server interno (mesmo servidor do Controle de Despesas)
DB_SERVER=192.168.0.250
DB_PORT=1433
DB_NAME=atas_bd
DB_USER=pwa
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# IIS local envia X-Forwarded-Proto=https
TRUST_PROXY=1

# Google Gemini (transcrição e ata)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PDF: caminho do Edge/Chrome. Vazio = procura o Microsoft Edge instalado.
PDF_BROWSER_PATH=
