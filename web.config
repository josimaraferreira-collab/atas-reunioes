<?xml version="1.0" encoding="utf-8"?>
<!-- Solven Atas: o IIS repassa /solven-atas/* para o serviço Node local (127.0.0.1:3001). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SolvenAtasNodeProxy" stopProcessing="true">
          <match url="^(.*)$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" replace="true" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3001/solven-atas/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- trechos de áudio de até 10 min (~5 MB); margem para 50 MB -->
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment=".env.producao" />
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="server" />
          <add segment="lib" />
          <add segment="migrations" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="service" />
          <add segment="scripts" />
          <add segment="test" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
