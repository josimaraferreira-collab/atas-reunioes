{
  "functions": {
    "api/pdf.js": { "maxDuration": 60, "includeFiles": "{pdf.js,pdf.css,brand/**,lib/**,node_modules/@fontsource/arimo/files/arimo-latin-*-normal.woff2}" },
    "api/docx.js": { "maxDuration": 30, "includeFiles": "{brand/**,lib/**}" }
  },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "Permissions-Policy", "value": "microphone=(self)" }] }
  ]
}
